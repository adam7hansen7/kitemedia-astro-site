---
import { mainNav, contact } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header" data-header>
  <div class="container header-bar">
    <a class="logo" href="/" aria-label="Kite Media home">
      <img src="/images/2023/09/KiteMedia-Logo.webp" alt="Kite Media" width="600" height="110" />
    </a>

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul class="nav-list">
        {mainNav.map((item) => (
          <li class={item.children ? 'has-sub' : undefined}>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>
                ))}
                <li><a href="/services/">See all services</a></li>
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a class="header-phone" href={contact.phoneHref}>{contact.phone}</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 23, 42, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-dark);
    color: #fff;
  }
  .header-bar {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: var(--header-h);
  }
  .logo img { width: 190px; }
  .nav { margin-left: auto; }
  .nav-list { display: flex; gap: var(--s-1); margin: 0; padding: 0; list-style: none; }
  .nav-list > li { position: relative; }
  .nav a {
    display: block;
    padding: var(--s-2) var(--s-3);
    color: var(--on-dark);
    font-size: 0.95rem;
    font-weight: 500;
    font-stretch: 85%;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover { color: #fff; }
  .nav a[aria-current='page'] { color: var(--sky); }
  .has-sub > a::after { content: ''; display: inline-block; width: 6px; height: 6px; margin-left: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-3px) rotate(45deg); }
  .sub {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 260px;
    margin: 0;
    padding: var(--s-2);
    list-style: none;
    background: var(--deep);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms;
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { padding: var(--s-2) var(--s-3); border-radius: 4px; }
  .sub a:hover { background: rgba(255, 255, 255, 0.06); }

  .header-phone {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }
  .header-phone:hover { color: var(--sky); }

  .menu-toggle { display: none; }

  @media (max-width: 1180px) {
    .nav-list a { padding-inline: var(--s-2); font-size: 0.9rem; }
  }
  @media (max-width: 1060px) {
    .header-phone { margin-left: auto; }
    .menu-toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      background: none;
      border: 0;
      color: #fff;
      cursor: pointer;
    }
    .bars { display: grid; gap: 6px; width: 26px; }
    .bars span { height: 2px; background: currentColor; transition: transform 200ms ease, opacity 200ms ease; }
    [aria-expanded='true'] .bars span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    [aria-expanded='true'] .bars span:nth-child(2) { opacity: 0; }
    [aria-expanded='true'] .bars span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

    .nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      margin: 0;
      padding: var(--s-6) var(--gutter) var(--s-8);
      background: var(--midnight);
      overflow-y: auto;
      display: none;
    }
    .nav.open { display: block; }
    .nav-list { flex-direction: column; gap: 0; }
    .nav-list > li { border-bottom: 1px solid var(--line-dark); }
    .nav-list > li > a { padding: var(--s-4) 0; font-family: var(--font-display); font-size: 2rem; letter-spacing: 0.03em; font-weight: 400; }
    .has-sub > a::after { display: none; }
    .sub { position: static; opacity: 1; visibility: visible; transform: none; background: none; border: 0; padding: 0 0 var(--s-4); }
    .sub a { padding: var(--s-2) 0; font-size: 1rem; }
  }
  @media (max-width: 520px) {
    .logo img { width: 150px; }
    .header-phone { font-size: 1.25rem; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') toggle.click();
  });
</script>
