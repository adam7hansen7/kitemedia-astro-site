---
import { form } from '../data/site';
interface Props { submitLabel?: string; source?: string }
const { submitLabel = 'Submit', source = '' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
const id = (n: string) => `${n}-${uid}`;
---
<form class="contact-form" method="post" action={form.endpoint || undefined} data-contact-form data-endpoint={form.endpoint}>
  {form.accessKey && <input type="hidden" name="access_key" value={form.accessKey} />}
  <input type="hidden" name="subject" value="New message from kitemedia.com" />
  <input type="hidden" name="page" value={source || Astro.url.pathname} />
  <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />
  <p class="form-note">" <span class="req">*</span> " indicates required fields</p>
  <div class="form-grid">
    <div class="field">
      <label for={id('name')}>Name <span class="req">*</span></label>
      <input id={id('name')} name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={id('biz')}>Business Name</label>
      <input id={id('biz')} name="business" type="text" autocomplete="organization" />
    </div>
    <div class="field">
      <label for={id('email')}>Email <span class="req">*</span></label>
      <input id={id('email')} name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for={id('phone')}>Phone <span class="req">*</span></label>
      <input id={id('phone')} name="phone" type="tel" autocomplete="tel" placeholder="(999) 999-9999" required />
    </div>
    <div class="field span-2">
      <label for={id('msg')}>Message</label>
      <textarea id={id('msg')} name="message"></textarea>
    </div>
    <div class="field span-2">
      <label for={id('ref')}>How did you hear about us?</label>
      <input id={id('ref')} name="referral" type="text" />
    </div>
  </div>
  <div class="btn-row">
    <button class="btn" type="submit">{submitLabel}</button>
  </div>
  <p class="form-status" role="status" aria-live="polite" data-form-status></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((formEl) => {
    formEl.addEventListener('submit', async (e) => {
      const status = formEl.querySelector<HTMLElement>('[data-form-status]')!;
      const endpoint = formEl.dataset.endpoint;
      e.preventDefault();
      if (!endpoint) {
        status.textContent = "This form isn't connected yet. Please call (435) 753-7553 or email info@kitemedia.com.";
        return;
      }
      const btn = formEl.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: new FormData(formEl), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = '/contact-us/thank-you/';
      } catch {
        status.textContent = "Your message didn't send. Please try again, or call (435) 753-7553.";
        btn.disabled = false;
      }
    });
  });
</script>
