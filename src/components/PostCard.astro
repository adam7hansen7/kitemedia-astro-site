---
interface Props { slug: string; title: string; date: Date; author: string; excerpt: string; image?: string; alt?: string; eager?: boolean }
const { slug, title, date, author, excerpt, image, alt = '', eager = false } = Astro.props;
const fmt = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<article class="post-card">
  {image && (
    <a class="thumb" href={`/${slug}/`} tabindex="-1" aria-hidden="true">
      <img src={image} alt={alt} loading={eager ? 'eager' : 'lazy'} />
    </a>
  )}
  <p class="meta">by {author} | <time datetime={date.toISOString()}>{fmt}</time></p>
  <h2><a href={`/${slug}/`}>{title}</a></h2>
  <p class="excerpt">{excerpt}</p>
  <a class="text-link" href={`/${slug}/`}>read more<span class="visually-hidden">: {title}</span></a>
</article>

<style>
  .post-card { display: flex; flex-direction: column; }
  .thumb { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); margin-bottom: var(--s-4); background: var(--mist); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms ease; }
  .post-card:hover .thumb img { transform: scale(1.03); }
  .meta { margin: 0 0 var(--s-2); font-size: var(--step--1); color: var(--slate); }
  h2 { font-family: var(--font-body); text-transform: none; font-size: var(--step-1); font-weight: 700; line-height: 1.3; font-stretch: 85%; letter-spacing: 0; margin-bottom: var(--s-3); }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--blue); }
  .excerpt { color: var(--slate); font-size: 0.975rem; flex: 1; }
</style>
