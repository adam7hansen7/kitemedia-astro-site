---
interface Props { items: { q: string; a: string }[]; dark?: boolean }
const { items, dark = true } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() },
  })),
};
---
<section class:list={['section', dark ? 'section--dark' : 'section--mist']} id="faq">
  <div class="container faq-layout">
    <div class="heading-block">
      <span class="kicker">FAQ</span>
      <h2>Frequently Asked Questions</h2>
    </div>
    <div class="faq-list">
      {items.map((item, i) => (
        <details class="faq" open={i === 0}>
          <summary><span>{item.q}</span><span class="icon" aria-hidden="true"></span></summary>
          <div class="answer prose" set:html={item.a} />
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq-layout { display: grid; gap: var(--s-6); }
  @media (min-width: 1000px) {
    .faq-layout { grid-template-columns: 1fr 2fr; gap: var(--s-8); align-items: start; }
    .faq-layout .heading-block { position: sticky; top: calc(var(--header-h) + var(--s-6)); }
  }
  .faq { border-bottom: 1px solid var(--line-dark); }
  .section--mist .faq { border-color: var(--line); }
  .faq:first-child { border-top: 1px solid var(--line-dark); }
  .section--mist .faq:first-child { border-color: var(--line); }
  summary {
    display: flex;
    justify-content: space-between;
    gap: var(--s-5);
    padding: var(--s-5) 0;
    font-size: var(--step-1);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--sky); }
  .icon { position: relative; flex: none; width: 18px; height: 18px; margin-top: 0.3em; }
  .icon::before, .icon::after { content: ''; position: absolute; left: 0; top: 8px; width: 18px; height: 2px; background: var(--sky); transition: transform 200ms ease; }
  .icon::after { transform: rotate(90deg); }
  .faq[open] .icon::after { transform: rotate(0deg); }
  .answer { padding-bottom: var(--s-6); }
  .answer :global(ol), .answer :global(ul) { padding-left: 1.3em; }
  .section--dark .answer { color: var(--on-dark); }
</style>
