---
interface Props { title: string; slug: string; image: string; logo?: string; tags?: string[]; eager?: boolean }
const { title, slug, image, logo, tags = [], eager = false } = Astro.props;
---
<a class="project" href={`/project/${slug}/`} data-tags={tags.join('|')}>
  <span class="thumb">
    <img src={image} alt="" loading={eager ? 'eager' : 'lazy'} />
    {logo && logo !== image && <span class="logo"><img src={logo} alt="" loading="lazy" /></span>}
  </span>
  <span class="meta">
    <span class="title">{title}</span>
    <span class="tags">{tags.join(', ')}</span>
  </span>
</a>

<style>
  .project { display: flex; flex-direction: column; gap: var(--s-4); color: inherit; text-decoration: none; }
  .thumb { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: var(--midnight); }
  .thumb > img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms ease, opacity 300ms ease; }
  .logo { position: absolute; inset: 0; display: grid; place-items: center; padding: 18%; background: rgba(8, 23, 42, 0.72); opacity: 0; transition: opacity 250ms ease; }
  .logo img { max-height: 100%; width: auto; object-fit: contain; filter: brightness(0) invert(1); }
  .project:hover .thumb > img, .project:focus-visible .thumb > img { transform: scale(1.04); }
  .project:hover .logo, .project:focus-visible .logo { opacity: 1; }
  .meta { display: flex; flex-direction: column; }
  .title { font-weight: 700; font-size: var(--step-1); font-stretch: 85%; line-height: 1.25; }
  .project:hover .title { color: var(--blue); }
  .tags { font-size: var(--step--1); color: var(--slate); }
</style>
