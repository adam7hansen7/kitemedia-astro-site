---
import { contact, social, footerServices } from '../data/site';
import SocialIcon from './SocialIcon.astro';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <img class="footer-logo" src="/images/2023/09/KiteMedia-Logo.webp" alt="Kite Media" width="600" height="110" loading="lazy" />
    </div>
    <div>
      <h2 class="footer-title">What We Do</h2>
      <ul class="footer-list">
        {footerServices.map((s) => <li>{s.href ? <a href={s.href}>{s.label}</a> : s.label}</li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-title">Contact</h2>
      <p>{contact.street}<br />{contact.city}</p>
      <p><a href={contact.phoneHref}>{contact.phone}</a><br /><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
    </div>
    <div>
      <h2 class="footer-title">Connect</h2>
      <ul class="social">
        {social.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener" aria-label={`Kite Media on ${s.name}`}><SocialIcon name={s.name} /></a></li>
        ))}
      </ul>
      <p class="legal">
        <a href="/privacy-policy/">Privacy Policy</a><br />
        <a href="/cookie-policy/">Cookie Policy</a>
      </p>
    </div>
  </div>
  <div class="container footer-base">
    <a href={contact.googlePartner} target="_blank" rel="noopener" class="partner">
      <img src="https://www.gstatic.com/partners/badge/images/2024/PremierBadgeClickable.svg" alt="Google Partner Premier badge" width="120" height="114" loading="lazy" />
    </a>
    <p>© Copyright Kite Media {new Date().getFullYear()}.</p>
  </div>
</footer>

<style>
  .site-footer { background: #050f1c; color: var(--on-dark-muted); padding-block: var(--s-9) var(--s-6); font-size: 0.95rem; }
  .site-footer a { color: var(--on-dark); text-decoration: none; }
  .site-footer a:hover { color: var(--sky); text-decoration: underline; }
  .footer-grid { display: grid; gap: var(--s-7) var(--s-6); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .footer-logo { width: 180px; }
  .footer-title { font-size: 1.75rem; color: #fff; margin-bottom: var(--s-4); }
  .footer-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); }
  .social { display: flex; gap: var(--s-3); list-style: none; margin: 0 0 var(--s-5); padding: 0; }
  .social a { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--line-dark); border-radius: 50%; }
  .social a:hover { border-color: var(--sky); }
  .footer-base { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-5); margin-top: var(--s-8); padding-top: var(--s-6); border-top: 1px solid var(--line-dark); }
  .partner img { width: 110px; height: auto; }
</style>
