---
// Blog posts live at the site root (/post-slug/), the same URLs WordPress used.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Brush from '../components/Brush.astro';
import PostCard from '../components/PostCard.astro';
import ContactSection from '../components/ContactSection.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, related: posts.filter((p) => p.id !== post.id).slice(Math.max(0, i - 1), Math.max(0, i - 1) + 3) },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = d.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  datePublished: d.date.toISOString(),
  dateModified: (d.modified ?? d.date).toISOString(),
  author: { '@type': 'Person', name: d.author },
  publisher: { '@type': 'Organization', name: 'Kite Media' },
  image: d.featuredImage ? new URL(d.featuredImage, Astro.site).href : undefined,
};
---
<Base title={d.seoTitle || `${d.title} - Kite Media`} description={d.description || d.excerpt} image={d.featuredImage || undefined} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article>
    <header class="post-hero blueprint">
      <div class="container container--narrow">
        <a class="back" href="/blog/">The Kite Media Blog</a>
        <h1>{d.title}</h1>
        <Brush />
        <p class="byline">by {d.author} | <time datetime={d.date.toISOString()}>{fmt}</time>{d.categories.length > 0 && <> | {d.categories.join(', ')}</>}</p>
      </div>
    </header>

    <div class="section">
      <div class="container container--narrow">
        {d.featuredImage && <img class="feature" src={d.featuredImage} alt={d.featuredAlt} loading="eager" />}
        <div class="article">
          <Content />
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--mist">
      <div class="container">
        <div class="heading-block"><h2>More from the blog</h2></div>
        <div class="related">
          {related.map((p) => <PostCard slug={p.id} title={p.data.title} date={p.data.date} author={p.data.author} excerpt={p.data.excerpt} image={p.data.featuredImage} alt={p.data.featuredAlt} />)}
        </div>
      </div>
    </section>
  )}

  <ContactSection />
</Base>

<style>
  .post-hero { padding-block: var(--s-9) var(--s-8); color: #fff; }
  .post-hero h1 { font-size: var(--step-4); }
  .back { display: inline-block; margin-bottom: var(--s-5); color: var(--sky); font-weight: 600; text-decoration: none; }
  .back::before { content: '← '; }
  .back:hover { text-decoration: underline; }
  .byline { margin-top: var(--s-4); color: var(--on-dark-muted); }
  .feature { width: 100%; border-radius: var(--radius); margin-bottom: var(--s-7); }
  .related { display: grid; gap: var(--s-6); grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
</style>
